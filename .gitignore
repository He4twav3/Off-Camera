# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template itself — no secrets in it, and it's the only
# place documenting which env vars a fresh checkout of this repo needs.
!.env.local.example

# vercel
.vercel

# captured lead emails and account credentials (see src/lib/leads.ts,
# src/lib/users.ts) — real visitor/user data, never commit
/data/*.jsonl
/data/users.json

# typescript
*.tsbuildinfo
next-env.d.ts
