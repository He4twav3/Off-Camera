# Copy this file to .env.local (gitignored, never committed) and fill in
# real values. Without RESEND_API_KEY set, the app still runs fine — see
# lib/mailer.ts — it just falls back to writing "sent" emails to
# data/outbox.jsonl instead of actually delivering them.

# Get a key at https://resend.com/api-keys (free tier is enough for this).
RESEND_API_KEY=

# Optional — defaults to Resend's shared onboarding@resend.dev sender,
# which only delivers to the email address your Resend account itself
# was signed up with until you verify a real domain there. Once you do,
# set this to something like "Off Camera <hello@yourdomain.com>".
# RESEND_FROM=

# --- Dodo Payments (card + UPI checkout, Merchant of Record) ---
# Without these set, the checkout page's card option is disabled rather
# than crashing — see lib/dodo.ts. Create an account (Individual, not
# Company — no business registration needed) at
# https://app.dodopayments.com, switch to Test Mode, then get a test key
# at Developer -> API Keys.
DODO_PAYMENTS_API_KEY=

# Set to "live_mode" only when actually going live — defaults to
# test_mode otherwise even if unset, unlike the SDK's own default.
# DODO_PAYMENTS_ENVIRONMENT=

# The Dodo "product" id representing the course — create it once via
# their API (see the create-product step in setup docs) rather than
# the dashboard's product form.
DODO_PAYMENTS_PRODUCT_ID=

# From Developer -> Webhooks in the Dodo dashboard. For local testing,
# Dodo can't reach localhost directly — use `ngrok http 3000` to get a
# public URL, add "<that-url>/api/webhook/dodo-payments" as the webhook
# endpoint there, and it'll show you this secret.
DODO_PAYMENTS_WEBHOOK_SECRET=

# --- NOWPayments (crypto checkout) ---
# Without these set, the checkout page's crypto option is disabled rather
# than crashing — see lib/nowpayments.ts.
#
# IMPORTANT: sandbox and production are two completely separate NOWPayments
# accounts with their own signup, own dashboard, and own keys — not a
# mode toggle within one account the way Dodo's test/live mode is.
# For testing, sign up at https://account-sandbox.nowpayments.io (NOT
# account.nowpayments.io, which is real/production) and get a key +
# IPN secret from its Store Settings.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Set to "live_mode" only once you've swapped in real keys from
# account.nowpayments.io (production) — defaults to sandbox otherwise
# even if unset, unlike the SDK's own default.
# NOWPAYMENTS_ENVIRONMENT=
